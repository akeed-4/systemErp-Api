{
  "ConnectionStrings": {
    "Catalog": "Server=(localdb)\\MSSQLLocalDB;Database=SystemErp_Catalog;Trusted_Connection=True;TrustServerCertificate=True",
    "Shared": "Server=(localdb)\\MSSQLLocalDB;Database=SystemErp_Shared;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Tenancy": {
    "DedicatedConnectionTemplate": "Server=(localdb)\\MSSQLLocalDB;Database={database};Trusted_Connection=True;TrustServerCertificate=True",
    "DedicatedDatabasePrefix": "SystemErp_T_",
    "TenantCacheSeconds": 60
  },
  "Jwt": {
    "Issuer": "SystemErp",
    "Audience": "SystemErp.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Outbox": {
    "Enabled": true,
    "PollSeconds": 5
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Identity": {
    "ExposeOtpInResponse": false,
    "OtpMinutes": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
