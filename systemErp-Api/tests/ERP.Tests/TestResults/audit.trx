      SELECT CASE&#xD;
          WHEN EXISTS (&#xD;
              SELECT 1&#xD;
              FROM [ContractTypeDefinition] AS [c]&#xD;
              WHERE [c].[TenantId] = @ef_filter__CurrentTenantId AND [c].[Code] = @contractType AND [c].[Billing] = N'boq_certificate') THEN CAST(1 AS bit)&#xD;
          ELSE CAST(0 AS bit)&#xD;
      END&#xD;
