          ELSE 0.0&#xD;
      END AS [ClosingDebit], CASE&#xD;
          WHEN ([s].[OpenNet] + [s].[PeriodDebit]) - [s].[PeriodCredit] &lt; 0.0 THEN -(([s].[OpenNet] + [s].[PeriodDebit]) - [s].[PeriodCredit])&#xD;
          ELSE 0.0&#xD;
      END AS [ClosingCredit]&#xD;
      FROM (&#xD;
          SELECT [j].[AccountCode] AS [Code], COALESCE(SUM(0.0), 0.0) AS [OpenNet], COALESCE(SUM([j].[Debit]), 0.0) AS [PeriodDebit], COALESCE(SUM([j].[Credit]), 0.0) AS [PeriodCredit]&#xD;
          FROM [JournalEntryLine] AS [j]&#xD;
          INNER JOIN (&#xD;
              SELECT [j0].[Id]&#xD;
              FROM [JournalEntry] AS [j0]&#xD;
              WHERE [j0].[TenantId] = @ef_filter__CurrentTenantId AND (@ef_filter__p6 = CAST(1 AS bit) OR (@ef_filter__p5 = CAST(1 AS bit) AND [j0].[WarehouseId] IS NULL) OR (@ef_filter__p12 = CAST(1 AS bit) AND [j0].[CreatedByUserId] = @ef_filter__ScopeUserId) OR (@ef_filter__p16 = CAST(1 AS bit) AND ([j0].[AssignedToUserId] = @ef_filter__ScopeUserId OR [j0].[CreatedByUserId] = @ef_filter__ScopeUserId))) AND (@ef_filter__p18 = CAST(1 AS bit) OR [j0].[WarehouseId] IS NULL) AND (@ef_filter__p22 = CAST(1 AS bit) OR [j0].[CreatedByUserId] = @ef_filter__WarehouseOwnerId)&#xD;
          ) AS [j1] ON [j].[JournalEntryId] = [j1].[Id]&#xD;
          WHERE [j].[TenantId] = @ef_filter__CurrentTenantId&#xD;
          GROUP BY [j].[AccountCode]&#xD;
      ) AS [s]&#xD;
      LEFT JOIN (&#xD;
          SELECT [a].[Code], [a].[NameAr], [a].[Type]&#xD;
          FROM [Account] AS [a]&#xD;
          WHERE [a].[TenantId] = @ef_filter__CurrentTenantId&#xD;
      ) AS [a0] ON [s].[Code] = [a0].[Code]&#xD;
      ORDER BY [s].[Code]&#xD;
