      SELECT TOP(@p) [s].[Code] AS [AccountCode], COALESCE([a0].[NameAr], [s].[Code]) AS [AccountNameAr], COALESCE([a0].[Type], N'Asset') AS [AccountCategory], CASE&#xD;
