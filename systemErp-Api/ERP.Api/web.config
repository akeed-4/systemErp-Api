<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdout: logs every console log line (including unhandled exceptions from ExceptionHandlingMiddleware) to
        .\logs\stdout_*.log in the site folder. Shared hosting keeps no other log, so without it a production 500
        leaves no trace. The publish step rewrites processPath/arguments for the target.
      -->
      <aspNetCore processPath="dotnet" arguments=".\ERP.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
