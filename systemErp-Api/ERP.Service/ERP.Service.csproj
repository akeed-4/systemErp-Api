<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ERP.Service</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\ERP.Core\ERP.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- يثبّت النسخة المصحّحة: Microsoft.Data.SqlClient يسحب 9.0.11 المصابة بثغرات (CVE-2026-84008) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="Zomp.EFCore.WindowFunctions.SqlServer" Version="10.1.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ERP.Core.Models.Shared" />
    <Using Include="ERP.Core.Models.Accounting" />
    <Using Include="ERP.Core.Models.CarShowroom" />
    <Using Include="ERP.Core.Models.POS" />
    <Using Include="ERP.Core.Resources" />
    <Using Include="ERP.Core.DTOs.Shared" />
    <Using Include="ERP.Core.DTOs.Accounting" />
    <Using Include="ERP.Core.DTOs.CarShowroom" />
    <Using Include="ERP.Core.DTOs.POS" />
    <Using Include="ERP.Core.Contracts.Shared" />
    <Using Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
</Project>
